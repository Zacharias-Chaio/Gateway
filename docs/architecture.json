  "cards": [
    {
      "dot": "cyan",
      "title": "采集链路",
      "items": [
        "每条链路独占一个 goroutine，断线后每 3 秒自动重连",
        "属性按寄存器分组合并读请求，工程值 = 原始值 × 系数 + 偏移",
        "帧间隔、重发次数、轮询周期均可按链路配置"
      ]
    },
    {
      "dot": "emerald",
      "title": "配置与监控",
      "items": [
        "浏览器内完成设备模型、链路通道、实时数据与报文监控",
        "配置保存即热重载，指纹未变化的链路保持原连接不重启",
        "SQLite 单文件持久化，日志同时输出终端、滚动文件与 SSE"
      ]
    },
    {
      "dot": "violet",
      "title": "北向出口",
      "items": [
        "遥测快照与写命令结果发布到 Core NATS data 主题",
        "订阅 cmd / query 主题，支持远程写值与拓扑查询",
        "NATS 不可用时自动降级，南向采集与本地配置不受影响"
      ]
    }
  ]
